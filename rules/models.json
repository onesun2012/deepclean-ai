{
  "$comment": "深清 DeepClean 本地模型规则。migrate 项默认不可删除，只能迁移到其他盘（目录联接）。moveable=true 表示支持一键迁移。",
  "tools": [
    {
      "id": "hf",
      "name": "Hugging Face",
      "category": "model",
      "processes": []
    },
    {
      "id": "ollama",
      "name": "Ollama",
      "category": "model",
      "processes": [
        "ollama.exe"
      ]
    },
    {
      "id": "pytorch",
      "name": "PyTorch / CUDA",
      "category": "model",
      "processes": []
    },
    {
      "id": "lmstudio",
      "name": "LM Studio",
      "category": "model",
      "processes": [
        "LM Studio.exe"
      ]
    }
  ],
  "buckets": [
    {
      "id": "hf-hub",
      "tool": "hf",
      "risk": "migrate",
      "moveable": true,
      "move_root": "%USERPROFILE%\\.cache\\huggingface\\hub",
      "labelZh": "模型仓库缓存",
      "labelEn": "Hub model cache",
      "hintZh": "仅预览第一个明确模型目录；当前版本不执行迁移。其他位置仅统计。",
      "hintEn": "Preview the first explicit model directory only. Migration execution is disabled; other locations are statistics only.",
      "paths": [
        "%USERPROFILE%\\.cache\\huggingface\\hub",
        "%USERPROFILE%\\.cache\\huggingface\\datasets"
      ]
    },
    {
      "id": "ollama-models",
      "tool": "ollama",
      "risk": "migrate",
      "moveable": true,
      "move_root": "%USERPROFILE%\\.ollama\\models",
      "labelZh": "模型文件",
      "labelEn": "Model blobs",
      "hintZh": "仅预览第一个明确模型目录；当前版本不执行迁移。其他位置仅统计。",
      "hintEn": "Preview the first explicit model directory only. Migration execution is disabled; other locations are statistics only.",
      "paths": [
        "%USERPROFILE%\\.ollama\\models"
      ]
    },
    {
      "id": "pytorch-cache",
      "tool": "pytorch",
      "risk": "migrate",
      "min_age_min": 1440,
      "labelZh": "CUDA / Hub 缓存",
      "labelEn": "CUDA / Hub cache",
      "hintZh": "包含模型权重，仅统计，不清理。",
      "hintEn": "Contains model weights. Statistics only; never cleaned.",
      "paths": [
        "%USERPROFILE%\\.cache\\torch",
        "%USERPROFILE%\\.cache\\clip"
      ],
      "default_off": true
    },
    {
      "id": "lmstudio-models",
      "tool": "lmstudio",
      "risk": "migrate",
      "moveable": true,
      "move_root": "%USERPROFILE%\\.lmstudio\\models",
      "labelZh": "模型文件",
      "labelEn": "Model files",
      "hintZh": "仅预览第一个明确模型目录；当前版本不执行迁移。其他位置仅统计。",
      "hintEn": "Preview the first explicit model directory only. Migration execution is disabled; other locations are statistics only.",
      "paths": [
        "%USERPROFILE%\\.lmstudio\\models",
        "%USERPROFILE%\\.cache\\lm-studio\\models"
      ]
    }
  ]
}
