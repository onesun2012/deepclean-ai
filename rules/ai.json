    {
      "id": "cursor-cache",
      "tool": "cursor",
      "risk": "safe",
      "min_age_min": 30,
      "labelZh": "应用缓存",
      "labelEn": "App cache",
      "hintZh": "日志、GPU 缓存与扩展缓存。删后下次打开会重建。",
      "hintEn": "Logs, GPU cache and extension cache. Rebuilds on next launch.",
      "paths": [
        "%APPDATA%\\Cursor\\Cache",
        "%APPDATA%\\Cursor\\CachedData",
        "%APPDATA%\\Cursor\\Code Cache",
        "%APPDATA%\\Cursor\\GPUCache",
        "%APPDATA%\\Cursor\\CachedExtensionVSIXs",
        "%APPDATA%\\Cursor\\logs"
      ]
    },
    {
      "id": "cursor-index",
      "tool": "cursor",
      "risk": "rebuildable",
      "min_age_min": 60,
      "labelZh": "代码索引",
      "labelEn": "Code index",
      "hintZh": "工作区语义索引与存储。可删，下次打开项目会重新扫描。",
      "hintEn": "Workspace semantic index and storage. Rebuilt when you reopen a project.",
      "paths": [
        "%APPDATA%\\Cursor\\User\\workspaceStorage"
      ]
    },
    {
      "id": "cursor-file-history",
      "tool": "cursor",
      "risk": "danger",
      "locked": true,
      "labelZh": "文件历史",
